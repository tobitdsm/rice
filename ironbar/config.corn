let {
    $tray = { type = "tray" }
    $clock = {
        type = "clock"
        format = " %d %B  %H:%M"
    }

    $focused = {
        type = "focused"
        show_icon = false
        show_title = true
        icon_size = 24
        icon_theme = "Tela-circle-nord"

        truncate.mode = "end"
        truncate.max_length = 22
    }

    // $music = {
    //     type = "music"
    //     player_type = "mpd"
    //     format = "{artist} - {title}"
    //     truncate = "end"
    //     // truncate.length = 30
    //     // truncate.max_length = 100
    //     icons.play = " "
    //     icons.pause = " "
    //     icons.prev = ""
    //     icons.next = ""
    //     music_dir = "~/Music"
    // }

    // $music = {
    //     type = "script"
    //     class = "play-pause"
    //     mode = "watch"
    //     cmd = ""
    // }

    $music = {
        type = "custom"
        bar = [
            {
                type = "button"
                name = "play-pause"
                class = "play-pause"
                label = "{{~/.config/ironbar/scripts/music}}"
                on_click = "!playerctl play-pause"
            }
        ]
    }

    $UPower = {
        type = "battery"
        format = "󱉝 {percentage}%"
        show_icon = false
        profiles = {
            bat_full = {
                when = { percent = 100 charging = false }
                format = "󰁹 {percentage}%"
            }
            bat_90 = {
                when = { percent = 93 charging = false }
                format = "󰂂 {percentage}%"
            }
            bat_80 = {
                when = { percent = 90 charging = false }
                format = "󰂁 {percentage}%"
            }
            bat_70 = {
                when = { percent = 80 charging = false }
                format = "󰂀 {percentage}%"
            }
            bat_60 = {
                when = { percent = 70 charging = false }
                format = "󰁿 {percentage}%"
            }
            bat_50 = {
                when = { percent = 60 charging = false }
                format = "󰁾 {percentage}%"
            }
            bat_40 = {
                when = { percent = 50 charging = false }
                format = "󰁽 {percentage}%"
            }
            bat_30 = {
                when = { percent = 40 charging = false }
                format = "󰁼 {percentage}%"
            }
            bat_20 = {
                when = { percent = 30 charging = false }
                format = "󰁻 {percentage}%"
            }
            bat_10 = {
                when = { percent = 20 charging = false }
                format = "󰁺 {percentage}%"
            }
            bat_critical = {
                when = { percent = 5 charging = false }
                format = "󱃍 {percentage}%"
            }
            bat_charging_full = {
                when = { charging = true percent = 100 }
                format = "󰂅 {percentage}%"
            }
            bat_charging_90 = {
                when = { charging = true percent = 93 }
                format = "󰂋 {percentage}%"
            }
            bat_charging_80 = {
                when = { charging = true percent = 90 }
                format = "󰂊 {percentage}%"
            }
            bat_charging_70 = {
                when = { charging = true percent = 80 }
                format = "󰢞 {percentage}%"
            }
            bat_charging_60 = {
                when = { charging = true percent = 70 }
                format = "󰂉 {percentage}%"
            }
            bat_charging_50 = {
                when = { charging = true percent = 60 }
                format = "󰢝 {percentage}%"
            }
            bat_charging_40 = {
                when = { charging = true percent = 50 }
                format = "󰂈 {percentage}%"
            }
            bat_charging_30 = {
                when = { charging = true percent = 40 }
                format = "󰂇 {percentage}%"
            }
            bat_charging_20 = {
                when = { charging = true percent = 30 }
                format = "󰂆 {percentage}%"
            }
            bat_charging_10 = {
                when = { charging = true percent = 20 }
                format = "󰢜 {percentage}%"
            }
            bat_charging_critical = {
                when = { charging = true percent = 5 }
                format = "󰢟 {percentage}%"
            }
        }
    }

    $nm = {
        type = "network_manager"
        interface_whitelist = [ "wlo1" ]
        profiles = {
            wifi_disconnected = {
                when = { type = "wifi" state = "disconnected" }
                icon = "󰖪"
            }
            wifi_acquiring = {
                when = { type = "wifi" state = "acquiring" }
                icon = "󱛇"
            }
            wifi_connected_none = {
                when = { type = "wifi" state = "connected" signal_strength = 20 }
                icon = "󰤯"
            }
            wifi_connected_weak = {
                when = { type = "wifi" state = "connected" signal_strength = 40 }
                icon = "󰤟"
            }
            wifi_connected_ok = {
                when = { type = "wifi" state = "connected" signal_strength = 50 }
                icon = "󰤢"
            }
            wifi_connected_good = {
                when = { type = "wifi" state = "connected" signal_strength = 80 }
                icon = "󰤥"
            }
            wifi_connected_excellent = {
                when = { type = "wifi" state = "connected" signal_strength = 100 }
                icon = "󰤨"
            }
        }
    }

    $SysInfo = {
        type = "sys_info"
        interval.temps = 300
        interval.disks = 300
        interval.memory = 30
        interval.cpu = 3
        interval.networks = 30

        format = [
            " {cpu_percent}%"
            " {memory_percent}%"
            " {temp_c:coretemp-Package-id-0}°C"
            "󰓢 {net_up@wlo1}/{net_down@wlo1}"
        ]
    }

    $cava_1 = {
        transition_type = "slide_end"
        transition_duration = 750
        name = "cava_1"
        type = "script"
        mode = "watch"
        cmd = "~/.config/ironbar/scripts/cava 1"
    }

    $cava_2 = {
        transition_type = "slide_end"
        transition_duration = 750
        name = "cava_2"
        type = "script"
        mode = "watch"
        cmd = "~/.config/ironbar/scripts/cava 2"
    }

    $volume = {
        type = "volume"
        format = "{icon} {percentage}%"
        max_volume = 100
        icons.volume_high = " "
        icons.volume_medium = " "
        icons.volume_low = " "
        icons.muted = "󰝟 "
        on_scroll_down = "wpctl set-volume @DEFAULT_SINK@ 2%- --limit 1"
        on_scroll_up = "wpctl set-volume @DEFAULT_SINK@ 2%+ --limit 1"
    }

    
    $wlogout = {
        type = "custom"
        bar = [
            {
                type = "button"
                name = "wlogout"
                class = "wlogout"
                label = "logout"
                on_click = "!hyprlock"
            }
        ]
    }

    // $weather = {
    //     name = "weather"
    //     class = "weather"
    //     type = "script"
    //     mode = "poll"
    //     interval = 600000
    //     cmd = "~/.config/ironbar/scripts/weather"
    // }

    $updates = {
        type = "custom"
        bar = [
            {
                type = "button"
                name = "updates"
                class = "updates"
                label = "{{cat ~/.config/ironbar/scripts/updates}}"
                on_click = "!kitty -e bash -ic \"mirror; limit update\""
            }
        ]
    }

    $arch = {
        type = "script"
        class = "arch"
        interval = 3600000
        cmd = "~/.config/ironbar/scripts/arch"
    }

    $epoch = {
        type = "script"
        class = "epoch"
        interval = 1000
        cmd = "date +%s | printf %X $(</dev/stdin)"
    }
   
    $start_1 = [ $focused $volume $cava_1 $music ]
    $start_2 = [ $focused $volume $cava_2 $music ]
    $center = [ $clock ]
    $end = [ $epoch $arch $updates $SysInfo $nm $UPower $tray $wlogout ]
}
in {
    monitors.eDP-1 = {
        icon_theme = "Tela-circle-nord"
        position = "top"
        start = $start_1
        center = $center
        end = $end
    }
    monitors.HDMI-A-1 = {
        icon_theme = "Tela-circle-nord"
        position = "top"
        start = $start_2
        center = $center
        end = $end
    }
}
